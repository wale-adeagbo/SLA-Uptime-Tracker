# Optional: persist DB elsewhere (default ./data/sla.db)
# DATA_DIR=/var/lib/sla-uptime-tracker

# Required in production for /api/cron/check (GET or POST)
# CRON_SECRET=long-random-string

# Optional JSON array to seed monitors on first boot (instead of example.com)
# SEED_MONITORS=[{"name":"API","url":"https://api.example.com/health"}]
